!.mvn/wrapper/maven-wrapper.properties

# ===== IDE：IntelliJ IDEA / Eclipse / VS Code =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath

# ===== 日志文件 =====
*.log
logs/

